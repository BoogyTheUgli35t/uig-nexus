# =============================================================================
# UIG Nexus — development environment
# =============================================================================
# This file is COMMITTED on purpose while we're in development, so that a fresh
# clone runs with no setup: `npm i && npm run dev` just works, and CI/preview
# builds have the same values the browser bundle already ships.
#
# Everything below is PUBLIC by design:
#   - the Supabase project URL is public,
#   - the publishable ("anon") key only ever gets the `anon` Postgres role and
#     is gated by Row Level Security — it is already visible in every browser
#     bundle via src/integrations/supabase/public-config.ts.
#
# SECRETS DO NOT GO IN THIS FILE. Put them in `.env.local`, which stays
# git-ignored, and in Lovable Cloud / Cloudflare secrets for deployed builds:
#   SUPABASE_SERVICE_ROLE_KEY   bypasses RLS entirely — full read/write on every
#                               table. Never commit it; rotate it if it leaks.
#   STRIPE_SECRET_KEY           live payment credentials.
#   STRIPE_WEBHOOK_SECRET       webhook signature verification.
#   LOVABLE_API_KEY             AI gateway key.
#   SUPER_ADMIN_EMAIL / SUPER_ADMIN_NAME / SUPER_ADMIN_PASSWORD
#                               scripts/bootstrap-super-admin.mjs only.
#   CLOUDINARY_URL              scripts/generate-images.mjs only.
#   E2E_TEST_EMAIL / E2E_TEST_PASSWORD
#                               authenticated Playwright runs.
# See .env.example for the full list and .env.local.example for a starter.
# =============================================================================

# --- Supabase: browser bundle (Vite inlines VITE_* at build time) ------------
VITE_SUPABASE_URL="https://djocumwhwbncrpbnsfsy.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRqb2N1bXdod2JuY3JwYm5zZnN5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc5MzAwNDUsImV4cCI6MjA5MzUwNjA0NX0.8_6lQ30G87o4Im_4Ph_zqE-vPILaiUemDduSYQNrTV8"

# --- Supabase: SSR / server runtime (read from process.env) ------------------
SUPABASE_URL="https://djocumwhwbncrpbnsfsy.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRqb2N1bXdod2JuY3JwYm5zZnN5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc5MzAwNDUsImV4cCI6MjA5MzUwNjA0NX0.8_6lQ30G87o4Im_4Ph_zqE-vPILaiUemDduSYQNrTV8"

