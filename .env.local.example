# Copy to `.env.local` (git-ignored) and fill in. These are SECRETS — they must
# never be committed, and never appear in a VITE_-prefixed variable, because
# anything VITE_* is inlined into the browser bundle.
#
# Deployed builds read the same names from Lovable Cloud / Cloudflare secrets.

# Bypasses Row Level Security — full read/write on every table.
SUPABASE_SERVICE_ROLE_KEY=""

# Payments (src/integrations/stripe/client.server.ts, src/routes/api/public/stripe-webhook.ts)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AI gateway (MVP checklist generation, Intelligence assistant)
LOVABLE_API_KEY=""

# scripts/bootstrap-super-admin.mjs
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_NAME=""
SUPER_ADMIN_PASSWORD=""

# scripts/generate-images.mjs
CLOUDINARY_URL=""

# Authenticated Playwright runs (e2e/*.spec.ts self-skip when unset)
E2E_TEST_EMAIL=""
E2E_TEST_PASSWORD=""
