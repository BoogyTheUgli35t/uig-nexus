# Copy this file to .env and fill in real values (never commit .env itself).
# These are provisioned automatically when you connect Supabase via Lovable Cloud;
# copy them from your Supabase project settings if you're running this outside Lovable.

# Public — safe to expose client-side, gated by Row Level Security.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<anon/publishable key>"
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon/publishable key>"

# Secret — server-only. Used by src/integrations/supabase/client.server.ts
# (supabaseAdmin) to bypass RLS for admin operations: the contact form, portal audit
# log, access requests, and division signup-seeding. NEVER expose this to the client
# or commit it — treat it like a root database password.
SUPABASE_SERVICE_ROLE_KEY="<service role key — keep secret>"

# Public — the UIG WhatsApp Business line, E.164 digits only, no "+" or spaces
# (e.g. 2348001234567). Leave it unset and the floating WhatsApp button and the
# per-listing "Enquire on WhatsApp" button both render nothing, which is the
# right behaviour: a placeholder number ships a chat button on every page that
# dials a line nobody owns.
VITE_WHATSAPP_NUMBER=""
